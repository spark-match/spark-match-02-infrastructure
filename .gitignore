# Terraform local cache and state
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Lock file: SI se commitea (reproducibilidad de versiones de providers).
# Solo gitignore si existe override local. La convencion es commitearlo.
!.terraform.lock.hcl

# Plan files (locales)
tfplan
tfplan.json

# Tfvars con secretos (NO se commitea terraform.tfvars.local ni *.secret.tfvars).
# Pero SI se commitean los tfvars "base" de cada env (sin secretos), porque
# contienen la config de la infra (CIDR, NAT, endpoints, etc.) que todos los devs
# necesitan sincronizada.
*.tfvars
!*.tfvars.example
!terraform.tfvars

# Plugin cache
.terraform.d/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Pre-commit cache
.cache/

# Bytecode de bootstrap/apply-bootstrap-policies.py
__pycache__/
*.pyc

# Respaldos de trust policies que escribe bootstrap/apply-bootstrap-policies.py.
# Son estado de una maquina concreta en un momento concreto, no fuente de
# verdad: la fuente esta en bootstrap/trust/. Se quedan fuera del repo para que
# nadie los confunda con lo versionado ni los aplique por error.
backups/

# Terragrunt cache (si se usa en el futuro)
.terragrunt-cache/
